# ═══════════════════════════════════════════════════════════════════════════════
# AltFlex AEGIS v3.0 — Environment Configuration
# Adaptive Exploit & Governance Intelligence System
# ═══════════════════════════════════════════════════════════════════════════════
#
# USAGE:
#   1. Copy this file to `.env`:      cp .env.example .env
#   2. Fill in real values for all empty/placeholder variables
#   3. NEVER commit `.env` to version control
#
# VALIDATION:
#   All variables are validated on startup via Zod schemas in @aegis/core.
#   Missing or malformed values will produce a detailed error table.
#
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
# Core application settings shared across all services.
NODE_ENV=development                     # development | test | production
APP_VERSION=3.0.0                        # Semantic version — synced with package.json
LOG_LEVEL=debug                          # debug | info | warn | error

# ── Database (PostgreSQL 16) ────────────────────────────────────────────────
# Primary relational datastore for Hacks Engine + Skills Engine.
#
# The values below are for running services on the host (pnpm dev), where
# Postgres is reachable on localhost. Under Docker Compose, `localhost` is the
# service's own container — so both compose files override POSTGRES_HOST and
# DATABASE_URL to the `postgres` service name. Compose `environment:` wins over
# this file, so editing DATABASE_URL here will NOT change what containers use;
# change the compose file (or the POSTGRES_* parts it builds the URL from).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegis_dev
POSTGRES_USER=aegis
# ⚠️  CHANGE in production — and keep the value URL-safe: it must NOT contain
# @ : / ? # . The password is interpolated into a postgresql:// connection
# string without percent-encoding, by docker-compose.prod.yml, by
# getDatabaseUrl() in apps/api-gateway/src/config/env.ts, and by the fallbacks
# in packages/core/src/database/{migrate,seed}.ts. A password of `p@ss` makes
# `ss` the host, which presents as an unreachable database rather than as a
# configuration error.
POSTGRES_PASSWORD=changeme
# Host-based development only — compose overrides the host to `postgres`.
DATABASE_URL=postgresql://aegis:changeme@localhost:5432/aegis_dev
DATABASE_SSL=false                       # Enable in production deployments
DATABASE_POOL_MIN=2                      # Minimum connection pool size
DATABASE_POOL_MAX=10                     # Maximum connection pool size

# ── Cache (Redis 7) ─────────────────────────────────────────────────────────
# Cache layer + BullMQ job queue backend for ETL workers.
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for local dev (no auth). Keep the comment off this line: Compose
# reads a trailing comment on an empty value as the value itself.
REDIS_PASSWORD=
REDIS_DB=0                               # Redis database index (0-15)
REDIS_KEY_PREFIX=aegis:                  # Namespace prefix for all keys

# ── Hacks Engine (Engine α) ─────────────────────────────────────────────────
# DefiLlama API + SunWeb3Sec/DeFiHackLabs data sources.
DEFILLAMA_API_URL=https://api.llama.fi
DEFI_HACK_LABS_REPO=SunWeb3Sec/DeFiHackLabs
# Block explorer API keys. Obtain from:
#   https://etherscan.io/myapikey · https://polygonscan.com/myapikey
#   https://bscscan.com/myapikey · https://arbiscan.io/myapikey
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
BSCSCAN_API_KEY=
ARBISCAN_API_KEY=
HACKS_SYNC_CRON=0 */6 * * *             # Sync every 6 hours
HACKS_SYNC_BATCH_SIZE=100               # Records per ETL batch

# ── Skills Engine (Engine β) ────────────────────────────────────────────────
# GitHub AI skill repo scraping + Safety Scanner configuration.
# Personal access token for GitHub API
GITHUB_TOKEN=
SKILLS_SAFETY_SCAN_ENABLED=true          # Toggle safety scanner on/off
SKILLS_AUTO_INDEX_INTERVAL_MS=3600000    # Auto-index interval: 1 hour (ms)
SKILLS_MAX_FILE_SIZE_KB=512              # Max skill file size to process (KB)

# ── Forensic Engine ─────────────────────────────────────────────────────────
# Foundry CLI integration + multi-chain RPC providers.
FOUNDRY_BIN_PATH=/usr/local/bin/forge    # Path to Foundry `forge` binary
RPC_URL_MAINNET=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL_BSC=https://bsc-dataseed1.binance.org
RPC_URL_POLYGON=https://polygon-rpc.com
RPC_URL_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_URL_OPTIMISM=https://mainnet.optimism.io
RPC_URL_AVALANCHE=https://api.avax.network/ext/bc/C/rpc
RPC_URL_BASE=https://mainnet.base.org

# ── API Gateway (Fastify BFF) ───────────────────────────────────────────────
# Unified API surface — Backend-for-Frontend pattern.
API_HOST=0.0.0.0                         # Bind address (0.0.0.0 for Docker)
API_PORT=4000                            # HTTP port
API_RATE_LIMIT_MAX=100                   # Max requests per window
API_RATE_LIMIT_WINDOW_MS=60000           # Rate limit window: 1 minute (ms)
JWT_SECRET=changeme-use-a-32-char-min-secret  # ⚠️  CHANGE in production! (min 32 chars)
JWT_EXPIRES_IN=7d                        # JWT token expiry duration
API_KEYS=key1,key2                       # Comma-separated API keys for service auth
CORS_ORIGIN=http://localhost:3000        # Allowed CORS origin(s)

# ── Frontend (Next.js 15) ───────────────────────────────────────────────────
# Client-exposed variables MUST use NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=AltFlex AEGIS
NEXT_PUBLIC_APP_VERSION=3.0.0
NEXT_PUBLIC_ENABLE_ANALYTICS=false       # Toggle analytics tracking

# ── Feature Flags ────────────────────────────────────────────────────────────
# Granular toggles for in-development features.
FEATURE_HACKS_DASHBOARD=true             # Enable Hacks Dashboard (Engine α)
FEATURE_SKILLS_EXPLORER=true             # Enable AI Skills Explorer (Engine β)
FEATURE_FORENSIC_ENGINE=false            # Enable Forensic Engine (Phase 5)
FEATURE_SAFETY_SCANNER=true              # Enable AI Skill Safety Scanner
FEATURE_DARK_MODE=true                   # Enable dark mode toggle in UI
