{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "terminal.integrated.profiles.windows": {
    "DevOps Terminal": {
      "source": "PowerShell",
      "icon": "shield",
      "color": "terminal.ansiYellow",
      "args": ["-NoLogo"]
    }
  },
  "terminal.integrated.defaultProfile.windows": "DevOps Terminal",
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.fontFamily": "'MesloLGS NF', 'CaskaydiaCove Nerd Font', 'Cascadia Code NF', 'FiraCode Nerd Font', 'JetBrainsMono Nerd Font', 'Cascadia Code', Consolas, monospace",
  "workbench.colorCustomizations": {
    "terminal.background": "#0b0f19",
    "terminal.foreground": "#f1f5f9",
    "terminalCursor.foreground": "#ffd700",
    "terminal.ansiBlack": "#0b0f19",
    "terminal.ansiRed": "#ef4444",
    "terminal.ansiGreen": "#2ecc71",
    "terminal.ansiYellow": "#ffd700",
    "terminal.ansiBlue": "#38bdf8",
    "terminal.ansiMagenta": "#bc8cff",
    "terminal.ansiCyan": "#00c4cc",
    "terminal.ansiWhite": "#f1f5f9"
  }
}
