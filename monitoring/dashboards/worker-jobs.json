  },
  "description": "BullMQ worker and Forensic Engine job metrics — active/failed/waiting counts, processing times, throughput.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
