          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(aegis_bullmq_job_duration_seconds_count{queue=~\"$queue\"}[1m])) * 60",
          "legendFormat": "Throughput",
          "refId": "A"
        }
      ],
      "title": "Job Throughput (jobs/min)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 6,
      "title": "⏱️ BullMQ Job Processing Time",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "Duration",
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum by (le, queue) (rate(aegis_bullmq_job_duration_seconds_bucket{queue=~\"$queue\", job_name=~\"$job_name\"}[5m])))",
          "legendFormat": "{{queue}} — p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le, queue) (rate(aegis_bullmq_job_duration_seconds_bucket{queue=~\"$queue\", job_name=~\"$job_name\"}[5m])))",
          "legendFormat": "{{queue}} — p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (le, queue) (rate(aegis_bullmq_job_duration_seconds_bucket{queue=~\"$queue\", job_name=~\"$job_name\"}[5m])))",
          "legendFormat": "{{queue}} — p99",
          "refId": "C"
        }
      ],
      "title": "Job Processing Latency (p50 / p95 / p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
