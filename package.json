{
  "name": "@aegis/root",
  "private": true,
  "version": "3.0.0",
  "packageManager": "pnpm@10.32.1",
  "description": "AltFlex AEGIS — Adaptive Exploit & Governance Intelligence System",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rm -rf node_modules",
    "typecheck": "turbo run typecheck",
    "prepare": "husky",
    "migrate": "tsx packages/core/src/database/migrate.ts",
    "migrate:down": "tsx packages/core/src/database/migrate.ts --rollback",
    "seed": "tsx packages/core/src/database/seed.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "ws": "^8.17.1"
    }
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  }
}
