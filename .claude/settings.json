{
  "project": "altflex-aegis",
  "version": "3.0.0",
  "description": "AltFlex AEGIS — Adaptive Exploit & Governance Intelligence System",
  "agent": {
    "model": "claude-opus-4",
    "maxTokens": 16384,
    "temperature": 0.1,
    "systemPromptPaths": [".claude/CLAUDE.md"]
  },
  "rules": {
    "autoLoad": true,
    "directory": ".claude/rules"
  },
  "commands": {
    "directory": ".claude/commands"
  },
  "skills": {
    "directory": ".claude/skills"
  },
  "context": {
    "includePatterns": [
      "packages/*/src/**/*.ts",
      "apps/*/src/**/*.ts",
      "apps/*/src/**/*.tsx",
      "docs/**/*.md",
      "*.json",
      "*.yaml",
      "*.yml"
    ],
    "excludePatterns": ["node_modules/**", "dist/**", ".next/**", "pnpm-lock.yaml", "*.log"]
  }
}
