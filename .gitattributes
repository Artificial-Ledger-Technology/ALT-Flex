# ═══════════════════════════════════════════════════════════════════════
# AltFlex AEGIS v3.0 — .gitattributes
# Git LFS tracking for large binary files + line-ending normalization
# ═══════════════════════════════════════════════════════════════════════

# ── Auto-detect text files and normalize line endings ─────────────────
* text=auto eol=lf

# ── Force LF for all source code ─────────────────────────────────────
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.sol text eol=lf
*.toml text eol=lf
*.env.example text eol=lf

# ── Force CRLF for Windows-specific files ────────────────────────────
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ── Binary files (do not diff) ───────────────────────────────────────
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary

# ── Lock files — do not diff in PRs ──────────────────────────────────
pnpm-lock.yaml -diff linguist-generated=true
package-lock.json -diff linguist-generated=true
yarn.lock -diff linguist-generated=true

# ═══════════════════════════════════════════════════════════════════════
# Git LFS — Large File Storage
# Track datasets, model weights, and large binary assets
# Install: git lfs install
# ═══════════════════════════════════════════════════════════════════════

# ── Machine Learning Model Weights ───────────────────────────────────
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.hdf5 filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.pickle filter=lfs diff=lfs merge=lfs -text

# ── Datasets (compressed & columnar formats) ─────────────────────────
*.csv.gz filter=lfs diff=lfs merge=lfs -text
*.parquet filter=lfs diff=lfs merge=lfs -text
*.arrow filter=lfs diff=lfs merge=lfs -text
*.feather filter=lfs diff=lfs merge=lfs -text
*.sqlite filter=lfs diff=lfs merge=lfs -text
*.db filter=lfs diff=lfs merge=lfs -text

# ── Large Research Assets ────────────────────────────────────────────
research/**/*.csv filter=lfs diff=lfs merge=lfs -text
research/**/*.json filter=lfs diff=lfs merge=lfs -text
research/**/*.npy filter=lfs diff=lfs merge=lfs -text
research/**/*.npz filter=lfs diff=lfs merge=lfs -text

# ── Docker Images (exported tarballs) ────────────────────────────────
*.tar.gz filter=lfs diff=lfs merge=lfs -text

# ── Foundry Compilation Artifacts (if committed) ─────────────────────
*.abi filter=lfs diff=lfs merge=lfs -text

# ── Jupyter Notebook Outputs (can be large with inline images) ───────
# Note: Prefer clearing outputs before commit; LFS is fallback
research/**/*.ipynb filter=lfs diff=lfs merge=lfs -text

# ═══════════════════════════════════════════════════════════════════════
# Linguist Overrides — GitHub language statistics
# ═══════════════════════════════════════════════════════════════════════
docs/** linguist-documentation
research/** linguist-documentation
infrastructure/** linguist-devops
*.sol linguist-language=Solidity
